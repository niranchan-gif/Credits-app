rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDoc(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validNumber(value) {
      return value is int || value is float;
    }

    function validBorrower() {
      return request.resource.data.name is string
        && request.resource.data.phone is string
        && validNumber(request.resource.data.amount)
        && validNumber(request.resource.data.paid)
        && validNumber(request.resource.data.remaining)
        && request.resource.data.amount >= 0
        && request.resource.data.paid >= 0
        && request.resource.data.remaining >= 0;
    }

    match /users/{uid} {
      allow read, write: if ownsUserDoc(uid);

      match /borrowers/{borrowerId} {
        allow read, delete: if ownsUserDoc(uid);
        allow create, update: if ownsUserDoc(uid) && validBorrower();
      }
    }
  }
}
